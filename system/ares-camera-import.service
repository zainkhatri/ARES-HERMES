[Unit]
Description=ARES camera import — Canon G7X III CCAPI
After=network.target network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/mnt/data/system/camera-import.env
ExecStartPre=/mnt/data/system/ares-camera-check-iface
ExecStart=/usr/bin/python3 -m camera.importer
WorkingDirectory=/mnt/data
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ares-camera-import

[Install]
WantedBy=multi-user.target
